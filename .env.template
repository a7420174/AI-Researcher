
# ================ container configuration ================
# workplace of the research agent
DOCKER_WORKPLACE_NAME=workplace_paper
# base image of the research agent
BASE_IMAGES=tjbtech1/airesearcher:v1
# completion model name, configuration details see: https://docs.litellm.ai/docs/
COMPLETION_MODEL=groq/llama-3.3-70b-versatile
# cheep model name, configuration details see: https://docs.litellm.ai/docs/
CHEEP_MODEL=groq/llama-3.3-70b-versatile

CACHE_POLICY=ask

# specific gpu of the research agent, can be: 
# '"device=0"' using the first gpu
# '"device=0,1"' using the first and second gpu
# '"all"' using all gpus
# '' for no gpu
GPUS=''

# name of the container
CONTAINER_NAME=paper_eval
# name of the workplace
WORKPLACE_NAME=workplace
# path of the cache
CACHE_PATH=cache
# port of the research agent
PORT=7020
# platform of the research agent
PLATFORM=linux/amd64

# ================ llm configuration ================
# github ai token of the research agent
GITHUB_AI_TOKEN=
# ollama api base url of the research agent
# API_BASE_URL=http://127.0.0.1:11434
# Gemini api key
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
GITHUB_API_KEY=
HF_TOKEN=
SAMBANOVA_API_KEY=
OPENALEX_API_KEY=

RPM_LIMIT=30
TPM_LIMIT=11000
RPD_LIMIT=1000

# ================ task configuration ================
# maximum iteration times of the research agent
MAX_ITER_TIMES=0
PAPER_FILE=paper_agent/paper_logs/paper.pdf

# ================ biomcp configuration ================
# AlphaGenome API key for variant prediction
ALPHAGENOME_API_KEY=your_alphagenome_api_key
# OncoKB token for cancer variant enrichment
ONCOKB_TOKEN=your_oncokb_token
# NCI API key for clinical trial search
NCI_API_KEY=your_nci_api_key
# NCBI API key for PubMed/PubTator rate limits
NCBI_API_KEY=your_ncbi_api_key
# OpenFDA API key for drug safety lookups
OPENFDA_API_KEY=your_openfda_api_key
